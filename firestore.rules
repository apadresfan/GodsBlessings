rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function verified() { return signedIn() && request.auth.token.email_verified == true; }
  function admin() { return signedIn() && request.auth.token.admin == true; }
  match /posts/{postId} {
   allow read: if true;
   allow create: if verified()
    && request.resource.data.keys().hasAll(['uid','name','text','category','image','createdAt'])
    && request.resource.data.keys().hasOnly(['uid','name','text','category','image','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
    && request.resource.data.category in ['Everyday grace','Answered prayers','Family & friends','Healing & hope','God’s creation']
    && request.resource.data.image is string && request.resource.data.image.size() < 180000
    && (request.resource.data.image == '' || request.resource.data.image.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
    && request.resource.data.createdAt == request.time;
   allow update: if false;
   allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
   match /amens/{uid} {
    allow read: if signedIn() && request.auth.uid == uid;
    allow create: if verified() && request.auth.uid == uid
     && exists(/databases/$(database)/documents/posts/$(postId))
     && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid;
    allow delete: if signedIn() && request.auth.uid == uid;
   }
  }
  match /reports/{reportId} {
   allow read, delete: if admin();
   allow create: if verified()
    && request.resource.data.keys().hasAll(['postId','uid','reason','createdAt'])
    && request.resource.data.keys().hasOnly(['postId','uid','reason','createdAt'])
    && request.resource.data.postId is string
    && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
    && reportId == request.resource.data.postId + '_' + request.auth.uid
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
    && request.resource.data.createdAt == request.time;
  }
 }
}
